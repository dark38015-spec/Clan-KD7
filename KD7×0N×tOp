-- سباون كل المعدات والأشياء (Models / Parts) في الماب حوالين اللاعب
BtnSpawnAllItems.MouseButton1Click:Connect(function()
    AddLagLog("سباون كل المعدات والأشياء حوالين اللاعب…")

    local char = lp.Character
    if not char or not char.PrimaryPart then
        AddLagLog("ما قدرنا نحدد مكان اللاعب")
        return
    end

    local basePos = char.PrimaryPart.Position
    local ringRadius = 15
    local angleStep = 15
    local angle = 0

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") or v:IsA("Part") then
            -- نتجنب أشياء الهب نفسه
            if v ~= MainFrame and not v:IsDescendantOf(MainFrame) then
                local clone = v:Clone()
                clone.Parent = workspace

                local x = basePos.X + math.cos(math.rad(angle)) * ringRadius
                local z = basePos.Z + math.sin(math.rad(angle)) * ringRadius
                local y = basePos.Y + 2

                if clone:IsA("Model") and clone.PrimaryPart then
                    clone:SetPrimaryPartCFrame(CFrame.new(x, y, z))
                elseif clone:IsA("Part") then
                    clone.CFrame = CFrame.new(x, y, z)
                end

                table.insert(SpawnedStuff, clone)
                AddLagLog("سباون شيء: "..v.Name)

                angle = angle + angleStep
            end
        end
    end

    AddLagLog("انتهى سباون كل المعدات والأشياء")
end)

