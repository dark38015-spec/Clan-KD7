local ESPObjects = {}

local function CreateESP(obj, color)
    if not obj or not obj:IsA("BasePart") then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = obj

    table.insert(ESPObjects, highlight)
end

-- رؤية اللاعبين
BtnESPPlayers.MouseButton1Click:Connect(function()
    AddESPLog("تفعيل رؤية اللاعبين…")

    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            for _, part in pairs(plr.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    CreateESP(part, Color3.fromRGB(0,255,0))
                end
            end
        end
    end

    AddESPLog("تم تفعيل رؤية اللاعبين")
end)

-- رؤية الأدوات
BtnESPTools.MouseButton1Click:Connect(function()
    AddESPLog("تفعيل رؤية الأدوات…")

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Tool") then
            if v:FindFirstChild("Handle") then
                CreateESP(v.Handle, Color3.fromRGB(255,255,0))
            end
        end
    end

    AddESPLog("تم تفعيل رؤية الأدوات")
end)

-- رؤية أجزاء الماب
BtnESPParts.MouseButton1Click:Connect(function()
    AddESPLog("تفعيل رؤية أجزاء الماب…")

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and v.Size.Magnitude > 5 then
            CreateESP(v, Color3.fromRGB(0,0,255))
        end
    end

    AddESPLog("تم تفعيل رؤية أجزاء الماب")
end)

-- رؤية من خلال الجدران (WallHack)
BtnWallHack.MouseButton1Click:Connect(function()
    AddESPLog("تفعيل رؤية من خلال الجدران…")

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = 0.5
        end
    end

    AddESPLog("تم تفعيل رؤية من خلال الجدران")
end)

-- تعطيل كل الـ ESP
BtnDisableESP.MouseButton1Click:Connect(function()
    AddESPLog("تعطيل كل الـ ESP…")

    for _, esp in pairs(ESPObjects) do
        if esp and esp.Parent then
            esp:Destroy()
        end
    end

    ESPObjects = {}

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = 0
        end
    end

    AddESPLog("تم تعطيل كل الـ ESP")
end)
