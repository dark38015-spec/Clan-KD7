local function CreateBillboard(target, text)
    if not target or not target.Character or not target.Character:FindFirstChild("Head") then
        AddBillLog("لا يمكن إنشاء لوحة")
        return
    end

    local bb = Instance.new("BillboardGui")
    bb.Parent = target.Character.Head
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.Adornee = target.Character.Head
    bb.AlwaysOnTop = true

    local label = Instance.new("TextLabel", bb)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Text = text

    return bb
end

-- لوحة فوق اللاعب
BtnBillSelf.MouseButton1Click:Connect(function()
    local text = BillboardTextBox.Text
    if text == "" then text = lp.Name end

    CreateBillboard(lp, text)
    AddBillLog("تم إنشاء لوحة فوق اللاعب")
end)

-- لوحة فوق الضحية
BtnBillTarget.MouseButton1Click:Connect(function()
    local text = BillboardTextBox.Text
    if text == "" then text = "Target" end

    local target = nil
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= lp then
            target = plr
            break
        end
    end

    if not target then
        AddBillLog("لا يوجد ضحية")
        return
    end

    CreateBillboard(target, text)
    AddBillLog("تم إنشاء لوحة فوق الضحية: "..target.Name)
end)

-- لوحة متحركة
BtnBillMove.MouseButton1Click:Connect(function()
    local text = BillboardTextBox.Text
    if text == "" then text = "KD7 Moving" end

    local bb = CreateBillboard(lp, text)
    if not bb then return end

    AddBillLog("لوحة متحركة شغالة")

    spawn(function()
        while bb.Parent do
            task.wait()
            bb.StudsOffset = Vector3.new(0, math.random(2,5), 0)
        end
    end)
end)

-- لوحة ID اللاعب
BtnBillID.MouseButton1Click:Connect(function()
    local id = lp.UserId
    CreateBillboard(lp, "ID: "..id)
    AddBillLog("تم إنشاء لوحة ID")
end)

