-- دالة إنشاء صفحة
function NewPage(name)
    local page = Instance.new("Frame")
    page.Name = name
    page.Size = UDim2.new(1,0,1,0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = Pages
    return page
end

-- دالة فتح صفحة
function OpenPage(name)
    for _, p in pairs(Pages:GetChildren()) do
        p.Visible = false
    end
    Pages[name].Visible = true
end

