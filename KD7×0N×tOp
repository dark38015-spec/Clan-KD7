local function FindScooterRemote()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            if string.find(string.lower(v.Name), "scooter") or string.find(string.lower(v.Name), "music") then
                ScooterRemoteBox.Text = v.Name
                ScooterInfo.Text = "تم العثور على الريموت: "..v.Name
                return v
            end
        end
    end
    ScooterInfo.Text = "لم يتم العثور على أي ريموت"
    return nil
end

BtnFindScooter.MouseButton1Click:Connect(function()
    FindScooterRemote()
end)

BtnPlayScooter.MouseButton1Click:Connect(function()
    local remoteName = ScooterRemoteBox.Text
    if remoteName == "" then return end
    local remote = workspace:FindFirstChild(remoteName, true)
