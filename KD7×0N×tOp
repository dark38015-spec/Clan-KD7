-- حذف تول
BtnRemoveTool.MouseButton1Click:Connect(function()
    local name = ToolNameBox.Text
    if name == "" then
        AddToolsLog("لم يتم إدخال اسم التول")
        return
    end

    for _, v in pairs(lp.Backpack:GetChildren()) do
        if v:IsA("Tool") and string.lower(v.Name) == string.lower(name) then
            v:Destroy()
            AddToolsLog("تم حذف التول: "..name)
            return
        end
    end

    AddToolsLog("التول غير موجود")
end)

-- تفعيل تول
BtnActivateTool.MouseButton1Click:Connect(function()
    local name = ToolNameBox.Text
    if name == "" then
        AddToolsLog("لم يتم إدخال اسم التول")
        return
    end

    for _, v in pairs(lp.Backpack:GetChildren()) do
        if v:IsA("Tool") and string.lower(v.Name) == string.lower(name) then
            lp.Character.Humanoid:EquipTool(v)
            AddToolsLog("تم تفعيل التول: "..name)
            return
        end
    end

