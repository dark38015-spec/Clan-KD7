local function FlingObject(modelName)
    local char = lp.Character
    if not char or not char.PrimaryPart then return end

    local obj = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and string.find(string.lower(v.Name), modelName) then
            obj = v
            break
        end
    end

    if not obj or not obj.PrimaryPart then
        AddFlingLog("لم يتم العثور على: "..modelName)
        return
    end

    AddFlingLog("فلنق: "..obj.Name)

    spawn(function()
        for i = 1, 40 do
            task.wait()
            char:SetPrimaryPartCFrame(obj.PrimaryPart.CFrame * CFrame.new(0, 0, -4))
        end
    end)
end

